//problem 5
void deposit(double &balance) {
    double amount;
    cout << "Enter amount to deposit: $";
    cin >> amount;

    if (amount > 0) {
        balance = balance + amount;
        cout << "Successfully deposited $" << amount << endl;
    } else {
        cout << "Invalid deposit amount!" << endl;
    }
}
void withdraw(double &balance) {
    double amount;
    cout << "Enter amount to withdraw: $";
    cin >> amount;

    if (amount <= 0) {
        cout << "Invalid withdrawal amount!" << endl;
    } else if (amount > balance) {
        cout << "Insufficient balance!" << endl;;
    } else {
        balance -= amount;
        cout << "Successfully withdrew $" << amount << endl;
    }
}
void checkBalance(double balance) {
    cout << "Your current balance is: $" << balance << endl;
}
int main() {
    double balance = 500.0;
    int choice;
    do{
        cout << "=== Simple Banking System ===" <<endl;
        cout << "1. Deposit" <<endl;
        cout << "2. Withdraw" <<endl;
        cout << "3. Check Balance" <<endl;
        cout << "4. Exit" <<endl;;
        cout << "Enter your choice: ";
        cin >> choice;
        switch (choice) {
            case 1:
                deposit(balance);
                break;
            case 2:
                withdraw(balance);
                break;
            case 3:
                checkBalance(balance);
                break;
            case 4:
                cout << "Exit" << endl;
                break;
            default:
                cout << "Invalid choice!"<< endl;
        }
    }while (choice != 4);
    return 0;
}

//problem 6
double calculateTotal(int numTickets, double priceTicket) {
    return numTickets * priceTicket;
}
int main() {
    int choice, tickets;
    double total;
    char option;

    do {
        cout << "=== Movie Ticket Booking System ===" <<endl;
        cout << "1. Movie A - $8" <<endl;
        cout << "2. Movie B - $10" <<endl;
        cout << "3. Movie C - $12" <<endl;
        cout << "Enter your choice (1-3): ";
        cin >> choice;
        cout << "Enter number of tickets: ";
        cin >> tickets;
        switch (choice) {
            case 1:
                total = calculateTotal(tickets, 8.0);
                cout << "You selected Movie A." << endl;
                cout << "Total cost: $" << total << endl;
                break;

            case 2:
                total = calculateTotal(tickets, 10.0);
                cout << "You selected Movie B." << endl;
                cout << "Total cost: $" << total << endl;
                break;

            case 3:
                total = calculateTotal(tickets, 12.0);
                cout << "You selected Movie C." << endl;
                cout << "Total cost: $" << total << endl;
                break;
            default:
                cout << "Invalid Choice!" << endl;
        }
        cout << "Do you want to continue?(y/n):";
        cin >> option;
    }while(option == 'y' || option == 'Y' );
    cout << "Thanks for using the Movie System!" << endl;
    return 0;
}

//problem 7
double calculateFee(int hours) {
    double fee = 0;
    if (hours <= 2) {
        fee = 0;
    }
    else if (hours <= 5) {
        fee = (hours - 2) * 2;
    }else {
        fee = (3 * 2) + ((hours - 5) * 5);
    }
    return fee;
}
int main() {
    int hours;
    char choice;
    while (true) {
        cout << "=== Car Parking Fee Calculator ===" << endl;
        cout << "Enter number of hours parked: ";
        cin >> hours;
        if (hours < 0) {
            cout << "Invalid input!" << endl;
            continue;
        }
        double fee = calculateFee(hours);
        cout << "Parking fee: $" << fee << endl;

        cout << "Do you want to calculate for another user? (y/n): ";
        cin >> choice;
        if (choice != 'y' && choice != 'Y') {
            cout << "Thank you for using this program!" << endl;
            break;
        }
    }
    return 0;
}

//problem 8
double calculateTotal(int quantity, double price) {
    return quantity * price;
}

int main() {
    int choice, quantity;
    double total = 0, itemTotal;
    char option;

    do {
        cout << "=== Restaurant Ordering System ===" << endl;
        cout << "1. Pizza  - $10" << endl;
        cout << "2. Burger - $8" << endl;
        cout << "3. Salad  - $5" << endl;
        cout << "4. Exit" << endl;
        cout << "Enter your choice (1-4): ";
        cin >> choice;

        if (choice == 4) {
            cout << "Thank you for using this program!" << endl;
            break;
        }

        cout << "Enter quantity: ";
        cin >> quantity;

        switch (choice) {
            case 1:
                itemTotal = calculateTotal(quantity, 10.0);
                cout << "You ordered " << quantity << " Pizza." << endl;
                break;
            case 2:
                itemTotal = calculateTotal(quantity, 8.0);
                cout << "You ordered " << quantity << " Burger." << endl;
                break;
            case 3:
                itemTotal = calculateTotal(quantity, 5.0);
                cout << "You ordered " << quantity << " Salad." << endl;
                break;
            default:
                cout << "Invalid choice!" << endl;
                itemTotal = 0;
        }

        total += itemTotal;
        cout << "Item total: $" << itemTotal << endl;
        cout << "Current bill: $" << total << endl;

        cout << endl << "Do you want to order more? (y/n): ";
        cin >> option;
        cout << endl;

    } while (option == 'y' || option == 'Y');

    cout << "Final Bill: " << total << endl;
    cout << "Thank you for using this program!" << endl;

    return 0;
}
