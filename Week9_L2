//problem 10
int power(int x, int y) {
    if (y == 0)
        return 1;
    if (y % 2 == 0) {
        int half = power(x, y / 2);
        return half * half;
    } else {
        return x * power(x, y - 1);
    }
}
int main() {
    int a, b;
    cout << "Enter a number: ";
    cin >> a;
    cout << "Enter the power: ";
    cin >> b;
    cout << "Result: " << power(a, b) << endl;
    return 0;
}
