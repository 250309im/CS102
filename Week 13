//problem 17
int add(int a, int b) {
    return a + b;
}
int multiply(int a, int b) {
    return a * b;
}
void calculate(int (*op)(int, int), int x, int y) {
    cout << "Result: " << op(x, y) << endl;
}
int main() {
    int x, y, choice;
    cout << "Enter two integers: ";
    cin >> x >> y;
    cout << "Choose operation:1. Add 2. Multiply: ";
    cin >> choice;
    if (choice == 1)
        calculate(add, x, y);
    else if (choice == 2)
        calculate(multiply, x, y);
    else
        cout << "Invalid choice!" << endl;
    return 0;
}
//problem 18
int add(int a, int b) {
    return a + b;
}
int multiply(int a, int b) {
    return a * b;
}
int main() {
    int (*ops[])(int, int) = {add, multiply};
    int choice, x, y;
    cout << "Enter two integers: ";
    cin >> x >> y;
    cout << "Choose operation:1. Add 2. Multiply: ";
    cin >> choice;
    if (choice == 1 || choice == 2)
        cout << "Result: " << ops[choice - 1](x, y) << endl;
    else
        cout << "Invalid choice!" << endl;
    return 0;
}
