//problem 10
int main() {
    int arr[5]= {9, 3, 7, 1, 6};
    int *ptr = arr;
    for (int i = 0; i < 5 - 1; i++) {
        for (int j = 0; j < 5 - i - 1; j++) {
            if (*(ptr + j) > *(ptr + j + 1)) {
                int temp = *(ptr + j);
                *(ptr + j) = *(ptr + j + 1);
                *(ptr + j + 1) = temp;
            }
        }
    }
    for (int i = 0; i < 5; i++) {
        cout << *(ptr + i) << " ";
    }
}
