int getTriangularNumber(int n) {
    return n * (n + 1) / 2;
}

int main() {
    const int totalNumbers = 75;
    const int numbersPerLine = 5;

    for (int i = 1; i <= totalNumbers; i++) {
        cout << getTriangularNumber(i) << "\t";
        if (i % numbersPerLine == 0) {
            cout << endl;
        }
    }

    return 0;
}
//problem 11
void displayEven(int number) {
    string numStr = to_string(number);
    bool foundEven = false;
    for (char ch : numStr) {
        if (isdigit(ch)) {
            int digit = ch - '0';
            if (digit % 2 == 0) {
                cout << digit << " ";
                foundEven = true;
            }
        }
    }
    if (!foundEven) {
        cout << "No even digits found.";
    }
    cout << endl;
}

int main() {
    int num;
    cout << "Enter a number: ";
    cin >> num;
    cout << "Even digits number: ";
    displayEven(num);
    return 0;
}
//problem 12
int cubeOfDigits(int number) {
    int sum = 0;
    int temp = number;
    if (temp < 0) {
        temp = -temp;
    }
    while (temp > 0) {
        int digit = temp % 10;
        sum += digit * digit * digit;
        temp /= 10;
    }

    return sum;
}
void isArmstrong(int sum, int number) {
    if (sum == number) {
        cout << number << " is Armstrong integer." << endl;
    } else {
        cout << number << " is not Armstrong integer." << endl;
    }
}

int main() {
    int num;
    cout << "Enter an integer: ";
    cin >> num;
    int sumOfCubes = cubeOfDigits(num);
    isArmstrong(sumOfCubes, num);
    return 0;
}

