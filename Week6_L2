int numberOfDaysInFebruary(int year) {
    if ((year % 400 == 0) || (year % 4 == 0 && year % 100 != 0)) {
        return 29;
    }
    return 28;
}

int main() {
    cout << "Year Days in February" << endl;
    for (int year = 1985; year >= 1983; year--) {
        cout << year <<" "<< numberOfDaysInFebruary(year) << endl;
    }

    return 0;
}

