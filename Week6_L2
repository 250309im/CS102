//problem 2
double calculateAcceleration(double v1, double v2, double t) {
    if (t == 0) {
        cerr << "Time can't be zero" << endl;
        return 0;
    }
    return (v2 - v1) / t;
}

int main() {
    double v1, v2, t;
    cout << "Enter initial velocity: ";
    cin >> v1;
    cout << "Enter final velocity: ";
    cin >> v2;
    cout << "Enter time: ";
    cin >> t;
    double acceleration = calculateAcceleration(v1, v2, t);
    cout << "The acceleration is: " << acceleration << " m/s^2" << endl;

    return 0;
}
