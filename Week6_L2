void printASCII(char ch1, char ch2, int numberPerLine) {
    int count = 0;
    for (char c = ch1; c <= ch2; ++c) {
        cout << c << ":" << int(c) << "  ";
        count++;
        if (count % numberPerLine == 0) {
            cout << endl;
        }
    }
    if (count % numberPerLine != 0) {
        cout << endl;
    }
}

