//problem 5
void swap(int &a, int &b) {
    a = a + b;
    b = a - b;
    a = a - b;
}

int main() {
    int x, y;
    cout << "Enter 2 number: ";
    cin >> x >> y;
    cout << "Before: x = " << x << ", y = " << y << endl;
    swap(x, y);
    cout << "After:  x = " << x << ", y = " << y << endl;
    return 0;
}

//problem 6
long long Factorial(long long n = 1) {
    long long result = 1;
    for (int i = 1; i <= n; ++i) {
        result *= i;
    }
    return result;
}

int main() {
    long long num;
    cout << "Enter a number: ";
    if (cin >> num) {
        cout << "Factorial: " << Factorial(num) << endl;
    } else {
        cout << "Factorial: " << Factorial() << endl;
    }

    return 0;
}

//problem 7
int gcd(int num1, int num2) {
    while (num2 != 0) {
        int temp = num2;
        num2 = num1 % num2;
        num1 = temp;
    }
    return num1;
}

int main() {
    int a, b;
    cout << "Enter 2 number: ";
    cin >> a >> b;
    cout << "GCD: " << gcd(a, b) << endl;
    return 0;
}
//problem 8
int findMax(int a, int b, int c) {
    int maxVal = a;
    if (b > maxVal) maxVal = b;
    if (c > maxVal) maxVal = c;
    return maxVal;
}

int findMin(int a, int b, int c) {
    int minVal = a;
    if (b < minVal) minVal = b;
    if (c < minVal) minVal = c;
    return minVal;
}

int main() {
    int num1, num2, num3;

    cout << "Enter 3 numbers: ";
    cin >> num1 >> num2 >> num3;

    cout << "Maximum number: " << findMax(num1, num2, num3) << endl;
    cout << "Minimum number: " << findMin(num1, num2, num3) << endl;

    return 0;
}
