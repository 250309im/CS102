//problem 14
int main() {
    int deck[4][13] = {0};
    const char* suits[4] = {"Hearts", "Diamonds", "Clubs", "Spades"};
    const char* faces[13] = {"Ace", "Two", "Three", "Four", "Five", "Six", "Seven", "Eight", "Nine", "Ten", "Jack", "Queen", "King"};
    int numbers[52];
    for (int i = 0; i < 52; i++) {
        numbers[i] = i + 1;
    }
    srand(time(0));
    for (int i = 51; i > 0; i--) {
        int j = rand() % (i + 1);
        int temp = numbers[i];
        numbers[i] = numbers[j];
        numbers[j] = temp;
    }
    int k = 0;
    for (int i = 0; i < 4; i++) {
        for (int j = 0; j < 13; j++) {
            deck[i][j] = numbers[k++];
        }
    }
    for (int i = 0; i < 4; i++) {
        for (int j = 0; j < 13; j++) {
            cout << faces[j] << " of " << suits[i] << endl;
        }
    }
    return 0;
}
