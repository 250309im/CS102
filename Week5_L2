int main() {
    //problem 17
    int num;
    int sum = 0;
    cout << "Enter a positive integer: ";
    cin >> num;
    num = abs(num);
    while (num > 0) {
        sum += num % 10;
        num = num / 10;
    }
    cout << "The sum of digits is " << sum << endl;
    return 0;
}

int main() {
    //problem 18
    int binary;
    int decimal = 0;
    int base = 1;
    cout << "Enter binary number: ";
    cin >> binary;
    while (binary != 0) {
        int remainder = binary % 10;
        decimal += remainder * base;
        binary /= 10;
        base *= 2;
    }
    cout << "The decimal number is " << decimal << endl;
    return 0;
}

