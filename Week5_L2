int main() {
    //problem 11
    int num;
    int positive = 0;
    int negative = 0;
    int counter = 0;
    float total = 0;
    cout << "Enter integers (end with 0): ";
    while(true) {
        cin >> num;
        if(num == 0) {
            break;
        }
        if(num < 0) {
            negative++;
        }
        else if (num > 0) {
            positive++;
        }
        total += num;
        counter++;
    }
    if (counter != 0) {
        float average = 0;
        average = total / counter;
        cout << "The number of positives is " << positive << endl;
        cout << "The number of negatives is " << negative << endl;
        cout << "The total is " << total << endl;
        cout << "The average is " << average << endl;
    }else{
        cout << "No Number Entered" << endl;
    }
    return 0;
}

