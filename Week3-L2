int main() {
    //problem 12
    int totalS= 241;
    int groups = 11;

    int pergroupS = totalS / groups;
    int remainder = totalS % groups;

    int firstgroup = pergroupS;
    int lastgroup = pergroupS + remainder;

    cout << "In first group: " << firstgroup << endl;
    cout << "In last group: " << lastgroup << endl;

    return 0;
}

